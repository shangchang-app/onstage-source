# ── 本地开发 ──
# 复制为 .env.local 后修改。命令行脚本也会读取 .env.local。不要把真实密钥提交到代码仓库。
# Node 24 LTS（最低 22.13，需自带 node:sqlite）。
#
# ── 托管平台（生产） ──
# 不要上传 .env 文件，在平台的「Environment / 环境变量」页面逐项填写。完整说明见 docs/部署指南.md。

# SQLite 数据库文件位置。
# 生产环境必须是持久化磁盘上的绝对路径，例如 Render：/var/data/onstage.sqlite（磁盘挂载在 /var/data）。
# 生产环境没有设置、或不是绝对路径时，网站会拒绝运行（避免把数据写进重新部署就会清空的目录）。
DATABASE_PATH=./data/onstage.sqlite

# 网站访问地址。所有写操作都校验请求来源必须是其中之一。
# 可以写多个，用英文逗号分隔（换域名期间新旧地址同时可用），例如：
#   APP_ORIGIN=https://try.example.com,https://onstage-trial.onrender.com
# 在 Render / Railway 上不填时，自动使用平台分配的地址（RENDER_EXTERNAL_URL / RAILWAY_PUBLIC_DOMAIN）。
# 生产环境的公网地址必须是 https。
APP_ORIGIN=http://127.0.0.1:3000

# 会话有效期（天）。每次打开网站自动续期，连续这么多天没打开才会过期。默认 30。
SESSION_DAYS=30

# 试用版演示内容：设为 seed-if-empty 时，只在数据库还没有任何内容时写入演示内容（全部标为「示例」），不会覆盖已有数据。
# 正式接入真实内容后删除这一项。
DEMO_CONTENT=

# 搜索引擎收录。试用期间保持空（不收录），正式上线后改为 true。
ALLOW_INDEXING=

# 备份目录。默认是数据库所在目录下的 backups/（与数据库在同一块持久化磁盘上）。
BACKUP_DIR=

# 短信验证码：mock 只允许开发 / 测试环境使用（验证码会显示在页面上）。
# 生产环境不设置（或设为 mock）时，登录不可用，网站以「访客模式」运行：可以浏览和做岗位体验，作答保存在访客自己的浏览器会话里。
# 以后接入短信：改为 http，并填写下面三项。
SMS_PROVIDER=mock
# HTTPS 短信网关约定：POST {phone,code,expiresInSeconds}，请求头 Authorization: Bearer <token>
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
# 验证码摘要用的密钥。接入短信时必须设置 32 位以上随机字符串（Render 上可以让平台自动生成）。
AUTH_SECRET=
