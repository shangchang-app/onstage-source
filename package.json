{
  "name": "onstage",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "build:static": "node scripts/build-static.mjs",
    "start": "next start --hostname 0.0.0.0",
    "start:local": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "admin": "tsx scripts/admin.ts",
    "admin:link": "tsx scripts/admin-link.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "test": "tsx --test tests/service.test.ts tests/deploy.test.ts tests/quick.test.ts tests/v16.test.ts tests/overseas-growth.test.ts",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:screens": "node tests/e2e/run.mjs --mode=screens",
    "test:deploy": "node tests/e2e/run.mjs --mode=deploy",
    "test:pages": "node tests/e2e/pages-check.cjs dist-pages",
    "test:rollback": "node tests/e2e/rollback-check.cjs",
    "test:growth": "node tests/e2e/growth-check.cjs dist-pages",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:e2e && npm run test:e2e:screens && npm run test:deploy",
    "package:pages": "node scripts/package-pages.mjs",
    "release": "npm run build:static && npm run test:pages && npm run package:pages"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
